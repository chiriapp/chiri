{
  "name": "chiri",
  "version": "1.0.0",
  "author": "Sapphic Angels",
  "description": "Cross-platform CalDAV task management app",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "license": "zlib/libpng",
  "scripts": {
    "build": "tsc && vite build",
    "build:app": "tauri build --config \"{\\\"bundle\\\":{\\\"createUpdaterArtifacts\\\":false}}\"",
    "check": "biome check && pnpm licenses:check",
    "dev": "vite",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "licenses:check": "node scripts/generate-licenses.ts --check",
    "licenses:generate": "node scripts/generate-licenses.ts",
    "lint": "biome lint .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "vitest run --project=node --project=jsdom",
    "test:coverage": "vitest run --project=node --project=jsdom --coverage",
    "test:integration": "vitest run --project=integration",
    "test:integration:all": "bash scripts/test-integration-all.sh",
    "test:watch": "vitest --project=node --project=jsdom"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.20",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@tauri-apps/plugin-fs": "2.7.0",
    "@tauri-apps/plugin-http": "^2.8.2",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "~2.7.1",
    "@tauri-apps/plugin-os": "~2.4.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-sql": "2.5.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "date-fns": "^4.4.0",
    "frimousse": "^0.4.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrule-temporal": "^2.2.8",
    "saxes": "^6.0.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@xmldom/xmldom": "^0.9.12",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.10",
    "vitest-canvas-mock": "^1.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": "biome check --write --no-errors-on-unmatched",
    "*.nix": "nixfmt",
    "*.rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --"
  }
}
